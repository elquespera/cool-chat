{
  "name": "cool-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"NEXTJS,SERVER\" -c \"auto\" \"next dev\" \"cd server && bun --hot ./index.ts\"",
    "turbo": "concurrently --names \"NEXTJS,SERVER\" -c \"auto\" \"next dev --turbo\" \"cd server && bun --hot ./index.ts\"",
    "build": "next build",
    "start": "concurrently -P --names \"NEXTJS,SERVER\" -c \"auto\" \"next start -- {@}\" \"cd server && bun ./index.ts\"",
    "lint": "next lint",
    "check": "tsc && next lint",
    "update": "bunx npm-check-updates -ui -p bun",
    "db:studio": "drizzle-kit studio",
    "migrations:generate": "drizzle-kit generate:sqlite",
    "migrations:push": "drizzle-kit push:sqlite",
    "migrations:drop": "drizzle-kit drop",
    "migrations:run": "drizzle-kit generate:sqlite && drizzle-kit push:sqlite"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@libsql/client": "^0.6.0",
    "@livekit/components-react": "^2.0.5",
    "@livekit/components-styles": "^1.0.11",
    "@lucia-auth/adapter-drizzle": "^1.0.7",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tailwindcss/container-queries": "^0.1.1",
    "arctic": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.30.6",
    "emoji-mart": "^5.5.2",
    "livekit-server-sdk": "^2.1.2",
    "lucia": "^3.1.1",
    "markdown-to-jsx": "^7.4.5",
    "nanoid": "^5.0.6",
    "next": "^14.1.4",
    "next-themes": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-photo-view": "^1.2.4",
    "react-use-websocket": "^4.8.1",
    "sharp": "^0.33.3",
    "socket.io": "^4.7.5",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.12",
    "@types/bun": "^1.0.12",
    "@types/node": "^20.12.3",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.23",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.4",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3"
  }
}
