{
  "name": "cool-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"NEXTJS,SERVER\" -c \"auto\" \"next dev\" \"cd server && bun --hot --env-file=../.env ./index.ts\"",
    "turbo": "concurrently --names \"NEXTJS,SERVER\" -c \"auto\" \"next dev --turbo\" \"cd server && bun --hot --env-file=../.env ./index.ts\"",
    "build": "next build",
    "start": "next start",
    "server": "cd server && bun ./index.ts",
    "lint": "next lint",
    "check": "tsc && next lint",
    "update": "bunx npm-check-updates -ui -p bun",
    "db:studio": "drizzle-kit studio",
    "migrations:generate": "drizzle-kit generate",
    "migrations:push": "drizzle-kit push",
    "migrations:drop": "drizzle-kit drop",
    "migrations:run": "drizzle-kit generate && drizzle-kit push"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@libsql/client": "^0.7.0",
    "@livekit/components-react": "^2.3.5",
    "@livekit/components-styles": "^1.0.12",
    "@lucia-auth/adapter-drizzle": "^1.0.7",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/better-sqlite3": "^7.6.11",
    "arctic": "^1.9.1",
    "better-sqlite3": "^11.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.31.4",
    "emoji-mart": "^5.6.0",
    "livekit-server-sdk": "^2.5.1",
    "lucia": "^3.2.0",
    "markdown-to-jsx": "^7.4.7",
    "nanoid": "^5.0.7",
    "next": "^14.2.4",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-photo-view": "^1.2.6",
    "react-use-websocket": "^4.8.1",
    "sharp": "^0.33.4",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unique-names-generator": "^4.7.1",
    "usehooks-ts": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/bun": "^1.1.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.22.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
